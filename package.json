{
  "name": "mediconnect-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "mobile": "npm --workspace=apps/mobile run start",
    "mobile:android": "npm --workspace=apps/mobile run android",
    "build:apk": "npm --workspace=apps/mobile run build:apk",
    "web": "npm --workspace=apps/web run dev",
    "build:shared": "npm --workspace=packages/shared run build"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
